{% extends '@theme/layout.twig' %}

{% set current_page = 'contatti' %}

{% block title %}Contatti · Maspes Piante e Fiori — Via Leone Leoni 2, Como{% endblock %}

{% block content %}

{# ---------- HEADER BAND ---------- #}
<section class="page-intro" aria-label="Contatti">
    <div class="container">
        <div class="page-intro__eyebrow"><span class="eyebrow eyebrow--bosco">Contatti</span></div>
        <h1>
            Via Leone Leoni 2, <em>Como.</em><br>
            <span style="font-style:italic;font-weight:300;">Dal 1954.</span>
        </h1>
        <p class="page-intro__lede">
            Telefono, email, indirizzo. Nessun centralino, nessun chatbot —
            risponde chi sta dietro il bancone, negli orari di apertura.
        </p>
    </div>
</section>

{# ---------- PHOTOGRAPHIC VIGNETTE ---------- #}
<figure style="margin:0 0 24px;">
    <div style="position:relative;aspect-ratio:21/9;background-image:url('/uploads/heritage/the_american_florist___a_weekly_journal_for_the_trade__1910_.jpg');background-size:cover;background-position:center;filter:grayscale(0.35) contrast(1.05);"></div>
    <figcaption style="max-width:1240px;margin:14px auto 0;padding:0 clamp(20px,4vw,32px);font-family:'Inter',sans-serif;font-size:0.8125rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--salvia);">
        La bottega — archivio
    </figcaption>
</figure>

{# ---------- TRE COLONNE ---------- #}
<section class="section section--tight" aria-label="Recapiti">
    <div class="container">
        <div class="three-col-hairlined">
            <div>
                <p>Telefono</p>
                <h3><a class="tabular" href="tel:+390312711360">031 27 11 36</a></h3>
                <p style="text-transform:none;letter-spacing:0;font-weight:400;color:var(--inchiostro-soft);font-size:0.9375rem;">Negli orari di apertura, risponde il negozio.</p>
            </div>
            <div>
                <p>Email</p>
                <h3><a href="mailto:info@maspespiantefiori.it">info@maspespiantefiori.it</a></h3>
                <p style="text-transform:none;letter-spacing:0;font-weight:400;color:var(--inchiostro-soft);font-size:0.9375rem;">Per ordini, preventivi e richieste su misura.</p>
            </div>
            <div>
                <p>Indirizzo</p>
                <h3>Via Leone Leoni 2,<br><em>22100 Como.</em></h3>
                <p style="text-transform:none;letter-spacing:0;font-weight:400;color:var(--inchiostro-soft);font-size:0.9375rem;"><a href="https://www.google.com/maps/search/?api=1&query=Via+Leone+Leoni+2+Como" target="_blank" rel="noopener">Apri in Google Maps →</a></p>
            </div>
        </div>
    </div>
</section>

