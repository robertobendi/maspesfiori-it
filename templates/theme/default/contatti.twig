        <div style="max-width:640px;margin:0 auto 32px;text-align:center;">
            <span class="eyebrow eyebrow--bosco">Orari di apertura</span>
            <h2 style="margin-top:14px;">Tutta la <em>settimana,</em> anche la domenica mattina.</h2>
        </div>
        <div class="hours-table" role="table" aria-label="Orari di apertura">
            <div class="row">
                <span class="day">Lunedì</span>
                <span class="hours">8:00–13:00 &nbsp;·&nbsp; 15:00–19:30</span>
            </div>
            <div class="row">
                <span class="day">Martedì</span>
                <span class="hours">8:00–13:00 &nbsp;·&nbsp; 15:00–19:30</span>
            </div>
            <div class="row">
                <span class="day">Mercoledì</span>
                <span class="hours">8:00–13:00 &nbsp;·&nbsp; 14:30–19:30</span>
            </div>
            <div class="row">
                <span class="day">Giovedì</span>
                <span class="hours">8:00–13:00 &nbsp;·&nbsp; 15:00–19:30</span>
            </div>
            <div class="row">
                <span class="day">Venerdì</span>
                <span class="hours">8:00–13:00 &nbsp;·&nbsp; 15:00–19:30</span>
            </div>
            <div class="row">
                <span class="day">Sabato</span>
                <span class="hours">8:00–13:00 &nbsp;·&nbsp; 14:30–19:30</span>
            </div>
            <div class="row">
                <span class="day">Domenica</span>
                <span class="hours">9:00–13:00</span>
            </div>
        </div>
    </div>
</section>

