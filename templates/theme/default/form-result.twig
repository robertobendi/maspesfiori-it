{% extends '@theme/layout.twig' %}

{% block title %}{{ ok ? 'Grazie' : 'Errore' }} · Maspes Piante e Fiori{% endblock %}

{% block content %}
<section class="section">
    <div class="container">
        <div style="max-width:560px;margin:64px auto;text-align:center;">
            {% if ok %}
                <span class="eyebrow eyebrow--bosco">Richiesta ricevuta</span>
                <h1 style="margin:20px 0 16px;">Grazie, <em>ti scriviamo a breve.</em></h1>
                <p class="lede">Abbiamo ricevuto la tua richiesta. Ti risponderemo a mano, dal negozio, negli orari di apertura.</p>
                <p style="margin-top:24px;color:var(--inchiostro-soft);">Se hai bisogno subito, <a href="tel:+390312711360" class="tabular">chiama 031 27 11 36</a>.</p>
                <p style="margin-top:48px;"><a class="btn btn--secondary" href="/">← Torna alla home</a></p>
            {% else %}
                <span class="eyebrow eyebrow--bosco">Qualcosa non ha funzionato</span>
                <h1 style="margin:20px 0 16px;">Riprova, <em>per favore.</em></h1>
                <ul style="display:inline-block;text-align:left;margin:24px 0;padding:0 0 0 1em;color:var(--inchiostro-soft);">
                    {% for e in errors %}<li>{{ e }}</li>{% endfor %}
                </ul>
                <p style="margin-top:24px;color:var(--inchiostro-soft);">Oppure scrivici subito a <a href="mailto:info@maspespiantefiori.it">info@maspespiantefiori.it</a> o chiama <a href="tel:+390312711360" class="tabular">031 27 11 36</a>.</p>
                <p style="margin-top:48px;"><a class="btn btn--secondary" href="javascript:history.back()">← Indietro</a></p>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
